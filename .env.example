NODE_ENV=development

# Bot's own DB (separate from production!)
MONGO_URL=mongodb://127.0.0.1:27017/phone_market_bot

# Admin bot - token from @BotFather, admins = comma-separated Telegram user IDs
BOT_TOKEN=
ADMIN_IDS=

# Userbot - api id/hash from https://my.telegram.org (dedicated account)
TG_API_ID=
TG_API_HASH=
# Filled by `npm run login`
TG_SESSION=

# Production API + bot seller account (role: user)
API_URL=https://api.telefonbozor.uz/api
SITE_URL=https://telefonbozor.uz
API_LOGIN=telefonbozor_bot
API_PASSWORD=

# Gemini fallback parser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Limits
MAX_POSTS_PER_JOB=50
MAX_SCAN_MESSAGES=500
MAX_POST_AGE_DAYS=0
DRAFT_TTL_DAYS=3
UNDO_WINDOW_HOURS=24
STORAGE_DIR=./storage
